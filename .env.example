# Set this to the exact public origin, including https, before deployment.
SITE_URL=http://localhost:3100
# Run npm run setup to generate local credentials. Never commit real values.
ADMIN_PASSWORD_HASH=
# false is for loopback HTTP development only; true for production HTTPS.
COOKIE_SECURE=false
# Vercel production: Neon Postgres URL and a connected private Blob store.
# Configure secrets in the Vercel dashboard; never commit their values.
DATABASE_URL=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Local SQLite and uploads, used when cloud services are not configured.
DATABASE_PATH=./data/baldwin.sqlite
UPLOAD_DIR=./data/uploads
# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional email notifications; inquiries always persist in the team inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_TO=
